# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://carchip_user:carchip_password@localhost:5432/carchip_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# WhatsGPS Integration
WHATSGPS_BASE_URL=https://api.whatsgps.com
WHATSGPS_API_KEY=your-whatsgps-api-key
WHATSGPS_USERNAME=your-whatsgps-username
WHATSGPS_PASSWORD=your-whatsgps-password

# Firebase FCM
FCM_PROJECT_ID=your-firebase-project-id
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"
FCM_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# SMTP (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Google OAuth
GOOGLE_CLIENT_ID=1047206584239-ucmoscubpk6plkn6930foc21tlpi5a45.apps.googleusercontent.com

# CORS
CORS_ORIGIN=https://app.carchip.com
